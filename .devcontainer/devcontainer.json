{
  "name": "CubeReps",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": ["--name", "cube-reps-dev", "--ipc=host"],
  "mounts": ["source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind,consistency=cached"],
  "postCreateCommand": "npm ci",
  "forwardPorts": [4200],
  "portsAttributes": {
    "4200": {
      "label": "Angular development server",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Angular.ng-template",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },
  "remoteUser": "node"
}
